# Copy to services/coach/.env (gitignored). No secrets are needed for local development:
# the operator token is generated per run and written to .runtime/api_token (0600).

# COACH_HOST=127.0.0.1          # localhost by default; LAN needs COACH_LAN=1 + TLS
# COACH_PORT=8765
# COACH_LAN=0
# COACH_TLS_CERT=.runtime/tls/server.crt
# COACH_TLS_KEY=.runtime/tls/server.key
# COACH_ALLOW_INSECURE_LAN=0    # development only; never for real use
# COACH_API_TOKEN=              # set only if you need a stable token; keep it out of git
# COACH_ALLOWED_ORIGINS=http://localhost:5173   # browser origins for a future UI (no wildcards)
# COACH_MAX_SESSIONS=20
# COACH_SESSION_TTL_S=7200
# COACH_EVENT_BUFFER=20000
# COACH_POSE_BUFFER=600
# COACH_MAX_MESSAGE_BYTES=262144
# COACH_ASSISTANT_URL=http://127.0.0.1:8766
# COACH_ASSISTANT_ENABLED=1

# Not read from this file: COACH_TUNING_FILE comes from the process environment only (export it, or pass
# --tuning). Threshold overrides for `coach brain-bridge` and `coach tune`; default services/coach/tuning.json,
# empty string = the code defaults.
# COACH_TUNING_FILE=services/coach/tuning.json
