# Copy to .env (git-ignored). Spec: "Config, env and repo layout".
BRAIN_PORT=8787
BRAIN_HOST=127.0.0.1               # 0.0.0.0 to reach the brain from another device on the LAN
CORS_ORIGINS=                      # extra browser origins, comma-separated; localhost on any port is always allowed
SESSION_DIR=./data/sessions       # the session (runs, reports, coach, deck) is saved here and continued after a restart
BRAIN_FRESH=0                     # 1 = start a new session instead (same as `--fresh`)
DEMO_CAMERA=                      # scripts/demo.sh: camera index for vision (find it: bash vision/run.sh --list-cameras)
LOG_LEVEL=info

COACH_CLEAN_RUNS=1               # clean runs needed per fading step: 1 for the demo, 2 for real use
COACH_MAX_TRAINING_RUNS=5

GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
JJ_VOICE=                          # a prebuilt Live voice name, e.g. Puck; empty = provider default
JJ_SPEECH_RMS=700                  # mic level that counts as "user speaking" for auto-resume after a wake
JJ_FAKE=0                          # 1 = run the brain without Gemini (FakeVoiceAgent); automatic when GEMINI_API_KEY is empty

# agent swarm (apps/brain/src/swarm): Gemini models, same GEMINI_API_KEY
SWARM_TEXT_MODEL=gemini-3.1-flash-lite            # director decisions (fast JSON)
SWARM_REPORT_MODEL=gemini-3.5-flash-lite          # reporter
SWARM_LISTENER_MODEL=gemini-3.1-flash-live-preview # listener: transcript + fillers (Live, audio)
SWARM_VIDEO_MODEL=gemini-3.5-flash-lite           # body agent: watches the run recording
# 1 = after each recorded run, a copy goes to Gemini for the body agent's analysis and is deleted there right after;
# 0 = recordings never leave this computer
SWARM_VIDEO_ANALYSIS=1
CHROME=                            # path to Chrome for the PDF report; empty = found automatically

# judges
ELEVENLABS_API_KEY=              # judge voices; empty = judges send say/gestures but no audio (works with JJ_FAKE=1)
JUDGE_VOICE_IDS=                 # the ElevenLabs voiceIds actually used for judge_1..judge_4, comma-separated; empty = premade defaults
JUDGE_VOICES=                    # scene voiceId hints for judge_1.. (comma-separated), kept in the scene/personas; the audio uses JUDGE_VOICE_IDS
