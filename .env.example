# Copy to .env (git-ignored). Spec: "Config, env and repo layout".
BRAIN_PORT=8787
SESSION_DIR=./data/sessions
RECORD_AUDIO=0
AUDIO_OUTPUT=headphones          # headphones | speakers
LOG_LEVEL=info

COACH_CLEAN_RUNS=1               # clean runs needed per fading step: 1 for the demo, 2 for real use
COACH_MAX_TRAINING_RUNS=5
WAKE_PHRASES=                     # extra wake-phrase regex alternatives, comma-separated

GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
JJ_VOICE=                          # a prebuilt Live voice name, e.g. Puck; empty = provider default
JJ_SPEECH_RMS=700                  # mic level that counts as "user speaking" for auto-resume after a wake
JJ_FAKE=0                          # 1 = run the brain without Gemini (FakeVoiceAgent)

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

LLM_PROVIDER=gemini              # gemini | anthropic  (digest, personas, judge questions)
LLM_MODEL=
ANTHROPIC_API_KEY=

TTS_PROVIDER=elevenlabs          # elevenlabs | gemini
ELEVENLABS_API_KEY=
JUDGE_VOICES=voiceA,voiceB,voiceC  # judge_1, judge_2, judge_3 …
