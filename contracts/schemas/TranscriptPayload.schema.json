{
  "$defs": {
    "TranscriptSegment": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 200,
          "title": "Text",
          "type": "string"
        },
        "start_s": {
          "description": "Offset from audio_start_at, seconds.",
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present only when the recognizer provides it.",
          "title": "Confidence"
        }
      },
      "required": [
        "text",
        "start_s",
        "duration_s"
      ],
      "title": "TranscriptSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "utterance_id": {
      "description": "Recognition task/utterance identity.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "title": "Utterance Id",
      "type": "string"
    },
    "revision": {
      "description": "Increases with every update of the same utterance.",
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "text": {
      "maxLength": 4000,
      "title": "Text",
      "type": "string"
    },
    "language": {
      "maxLength": 16,
      "title": "Language",
      "type": "string"
    },
    "on_device": {
      "description": "True only if recognition was required to run on device.",
      "title": "On Device",
      "type": "boolean"
    },
    "audio_start_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Wall time of the utterance's first audio sample.",
      "title": "Audio Start At"
    },
    "segments": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/TranscriptSegment"
          },
          "maxItems": 1000,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Segments"
    },
    "recognizer": {
      "default": "SFSpeechRecognizer",
      "maxLength": 64,
      "title": "Recognizer",
      "type": "string"
    }
  },
  "required": [
    "utterance_id",
    "revision",
    "text",
    "language",
    "on_device"
  ],
  "title": "TranscriptPayload",
  "type": "object",
  "$id": "https://garaza-frontier.local/schemas/1.0/TranscriptPayload.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
