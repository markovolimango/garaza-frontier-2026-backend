  "components": {
    "schemas": {
      "CalibrationRequest": {
        "properties": {
          "duration_s": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 600.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration S"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CalibrationRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PairRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 12,
            "minLength": 6,
            "title": "Code"
          },
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
            "title": "Device Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "iphone",
              "mac",
              "simulator"
            ],
            "title": "Kind"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "device_id",
          "kind"
        ],
        "title": "PairRequest"
      },
      "SessionCreate": {
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "mic_source": {
            "type": "string",
            "enum": [
              "iphone",
              "mac",
              "none"
            ],
            "title": "Mic Source",
            "description": "Exactly one authoritative microphone.",
            "default": "iphone"
          },
          "timeline": {
            "type": "string",
            "enum": [
              "live",
              "event_time"
            ],
            "title": "Timeline",
            "description": "live: server clock drives rules. event_time: corrected event times drive rules (deterministic simulation/replay, may run faster than real time).",
            "default": "live"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated",
            "description": "Session intended for synthetic data.",
            "default": false
          },
          "config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Config",
            "description": "Overrides for SessionConfig (see GET /v1/capabilities)."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SessionCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
